{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaXXX",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/MaaXYZ/MaaPracticeBoilerplate",
    "version": "1.0.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "PrintWindow", // 截图方式
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "./resource"
                // "./resource_bilibili"
            ]
        }
    ],
    // 自定义识别/动作需要 Agent（普通 Python 子进程，不是大模型）
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "一键日常",
            "entry": "一键日常",
            "description": "启动游戏 → 基地任务 → JJC（一条龙）"
        },
        {
            "name": "启动游戏",
            "entry": "点击游戏名称",
            "description": "从桌面进入游戏并处理常见弹窗（结束后会进基地，因与一条龙共用衔接）"
        },
        {
            "name": "领取邮件",
            "entry": "领取邮件",
            "description": "主界面领邮件后回到主菜单"
        },
        {
            "name": "基地任务",
            "entry": "家园任务",
            "description": "采矿 / 商店黑匣 / 刷支援卷（结束后会进 JJC，因与一条龙共用衔接）"
        },
        {
            "name": "JJC",
            "entry": "JJC出击",
            "description": "镜像竞技刷挑战，次数用完后回主菜单"
        },
        {
            "name": "日常刷体力",
            "entry": "日常任务出击",
            "description": "荒墟拾遗扫荡（开发中）"
        },
        {
            "name": "周本",
            "entry": "活动探索",
            "description": "碎星虚影 · 宙斯"
        }
    ]
}