{
    "interface_version": 2,
    "name": "MaaXXX",
    "description": "交错战线助手（基于 MCCA 任务结构）",
    "version": "1.0.0",
    "pretask": {
        "name": "自动启动 MuMu 12",
        "label": "仅在选择启动游戏时运行",
        "description": "自动查找 MuMu 12、启动实例、配置 ADB 并打开交错战线。",
        "exec": "../../agent/ensure_mumu.cmd",
        "args": []
    },
    "controller": [
        {
            "name": "ADB 默认方式",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "{PROJECT_DIR}/resource"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "{PROJECT_DIR}/resource",
                "{PROJECT_DIR}/resource/bilibili"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "{PROJECT_DIR}/agent/main.py"
        ]
    },
    "task": [
        {
            "name": "添加订单好友",
            "entry": "订单好友添加流程",
            "doc": "按订单源加好友；URL 见 config/orders_source.json；加完后跑活动，再另开「拉黑订单好友」"
        },
        {
            "name": "拉黑订单好友",
            "entry": "拉黑好友流程",
            "doc": "按 config/orders_state.json 的 friends 逐个屏蔽并移出登记（需 Agent）"
        },
        {
            "name": "单号连接测试",
            "entry": "订单好友添加流程",
            "doc": "[color:gray]已拆成「添加订单好友」+「拉黑订单好友」，保留此名兼容旧配置[/color]"
        },
        {
            "name": "启动游戏",
            "entry": "进入首页",
            "doc": "优先复用可用的 ADB 连接，连接失败时自动查找并启动 MuMu。",
            "option": [
                "MuMu实例",
                "模拟器自动启动",
                "每次重新检测连接"
            ]
        },
        {
            "name": "活动",
            "entry": "活动_入口",
            "doc": "[color:red]活动功能暂时只有困难最后一关，且版本更新后未必能继续使用[/color]"
        },
        {
            "name": "每日免费礼包",
            "entry": "每日免费礼包",
            "doc": "无"
        },
        {
            "name": "限时贸易所购买",
            "entry": "限时贸易所购买",
            "doc": "无"
        },
        {
            "name": "竞技场",
            "entry": "ArenaTask",
            "doc": "读取己方与顶部对手战力，按策略刷新并挑战。",
            "option": [
                "刷取策略",
                "战力差时依然挑战",
                "重复挑战方式"
            ]
        },
        {
            "name": "芯片筛选-仓库",
            "entry": "ChipDetailReadTask",
            "doc": "根据已保存的芯片筛选方案检查仓库内全部芯片，并纠正其上锁状态。"
        },
        {
            "name": "基建",
            "entry": "基建",
            "doc": "可能会有bug",
            "option": [
                "是否访问每个好友换抽"
            ]
        },
        {
            "name": "每日探索",
            "entry": "出击任务列表",
            "option": [
                "关卡选择",
                "第几层",
                "是否手动选择次数(开启燃料使用)",
                "手动次数"
            ]
        },
        {
            "name": "周本",
            "entry": "周本",
            "pipeline_override": {
                "首页_出击": {
                    "next": "活动探索"
                }
            },
            "option": [
                "周本关卡选择"
            ]
        },
        {
            "name": "领取奖励(邮箱+每日+通行证)",
            "entry": "领取奖励",
            "doc": "无"
        },
        {
            "name": "关闭游戏",
            "entry": "关闭游戏"
        },
        {
            "name": "历战试炼",
            "entry": "历战试炼",
            "doc": "测试中,暂时仅支持打限时boss，任务目标达到10为高进度，将不会继续任务；[color:red]开启该任务需自行配置有足够强度的队伍[/color]",
            "pipeline_override": {
                "活动选择": {
                    "expected": "历战试炼",
                    "next": "历战试炼-关卡选择"
                }
            },
            "option": [
                "是否打挑战难度",
                "挑战难度选择"
            ]
        }
    ],
